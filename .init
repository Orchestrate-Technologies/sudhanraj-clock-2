project:
  id: clock-2
  name: clock-2
  description: "A frontend clock web app showing current time, date, timezone, display preferences, and persisted preferences."
  type: frontend
  structure: monorepo
  repository: sudhanraj/clock-2

runtime:
  primary: node
  package_manager: pnpm

frontend:
  enabled: true
  framework: nextjs

backend:
  enabled: false
  framework: none

database:
  enabled: false
  engine: none
  name: null

infrastructure:
  profile: aws-serverless-cloudformation
  default_profile: aws
  aws_profile: null
  aws_region: null
  notes:
    - "Frontend deployments should use S3 and CloudFront if deployment is enabled later."
    - "AWS profile and region are intentionally unset until deployment work is requested."

release:
  policy: PR-ONLY
  provider: github
  base_branch: main
  branch_prefix: release/
  branch_format: "R{release_number}-{release_title_slug}"
  tag_format: "v{release_number}.{deployment_number}"
  pr_draft_until_release_tested: true
  release_label_pattern: "R{number}"

deployment:
  mode: none
  require_merge_to_base_before_deploy: false
  deployed_verification_required: false
  deployed_url: null

orchestration:
  mode: coordinator-with-worker-sessions
  worker_session_scope: per-issue
  parallel_implementation: false
  parallel_review: true
  require_isolated_worktree_for_parallel_writes: true

quality:
  self_review_required: true
  independent_review_required: true
  static_checks_required: true
  security_review_required: true
  dependency_review_required: true

linear:
  project: Clock 2
  releases:
    - label: R1
      title: clock-display-foundation
      parent_epic_ids: []
      parent_epic_chain: []
      parent_epic_titles: {}
      issue_ids:
        - ORC-250
        - ORC-252
        - ORC-251
      sequence_document_url: null
    - label: R2
      title: presentation-preferences
      parent_epic_ids: []
      parent_epic_chain: []
      parent_epic_titles: {}
      issue_ids:
        - ORC-253
        - ORC-254
      sequence_document_url: null
    - label: R3
      title: preference-persistence
      parent_epic_ids: []
      parent_epic_chain: []
      parent_epic_titles: {}
      issue_ids:
        - ORC-255
        - ORC-256
      sequence_document_url: null
  flagged_tickets:
    - id: ORC-259
      title: "Fix the alarm bug"
      reason: "NON-DAEDALUS FORMAT"
      action: skipped
    - id: ORC-258
      title: "CLK-009 — Play hourly chime"
      reason: "MISSING REQUIRED SECTION · STATES"
      action: skipped
    - id: ORC-257
      title: "CLK-008 — Set alarm at specific time"
      reason: "MISSING RELEASE LABEL"
      action: skipped
  statuses:
    backlog: Backlog
    todo: Todo
    blocked: Blocked
    in_progress: In Progress
    in_review: In Review
    build_complete: Build Complete
    pr_open: PR Open
    deployed: Deployed
    deployed_tested: Deployed & Tested
    canceled: Canceled
    duplicate: Duplicate
  blocker_satisfied_statuses:
    per_release:
      - Build Complete
      - PR Open
      - Deployed
      - Deployed & Tested
    per_ticket:
      - PR Open
      - Deployed
      - Deployed & Tested
  selection:
    ready_status: Todo
    working_status: In Progress
    blocked_status: Blocked
    local_complete_status: Build Complete
    release_label_pattern: "R{number}"
    priority_order:
      - Urgent
      - High
      - Medium
      - Low

testing:
  local_required: true
  acceptance_criteria_required: true
  browser_tool: playwright
  deployed_verification_required: false
  commands:
    - pnpm lint
    - pnpm test
  build_commands:
    - pnpm build
  notes:
    - "No package scripts exist yet; create these commands when the frontend app is scaffolded."

design:
  reference: null
  fidelity: loose-inspiration
