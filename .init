project:
  id: clock-2
  name: clock-2
  description: "A frontend clock web app showing the current time, today's date, and a 12-hour or 24-hour display preference."
  type: frontend
  structure: monorepo
  repository: sudhanraj/clock-2

runtime:
  primary: node
  package_manager: pnpm

frontend:
  enabled: true
  framework: nextjs
  app_root: frontend
  package_manager: pnpm
  install_command: pnpm install --frozen-lockfile
  build_command: pnpm build
  test_commands:
    - pnpm lint
    - pnpm test
  notes:
    - "Deployable frontend source, package.json, lockfiles, tests, and build config live under frontend/."
    - "Do not scaffold frontend app files at the repository root unless frontend.app_root is explicitly changed."

backend:
  enabled: false
  framework: none

database:
  enabled: false
  engine: none
  name: null

infrastructure:
  profile: aws-serverless-cloudformation
  default_profile: aws
  aws_profile: null
  aws_region: null
  notes:
    - "Frontend deployments are managed by Forge through AWS Amplify using frontend/ as the app root."
    - "AWS profile and region are supplied by Forge environment configuration and are not stored in this project config."

release:
  policy: PR-ONLY
  provider: github
  base_branch: main
  branch_prefix: release/
  branch_format: "R{release_number}-{release_title_slug}"
  tag_format: "v{release_number}.{deployment_number}"
  pr_draft_until_release_tested: true
  release_label_pattern: "R{number}"

deployment:
  mode: per-release
  provider: amplify
  frontend_app_root: frontend
  production_branch: main
  branch_prefix: release/
  require_merge_to_base_before_deploy: false
  deployed_verification_required: true
  deployed_url: null
  notes:
    - "The main branch is the production Amplify branch when production deployment is enabled."
    - "Each release branch gets its own Amplify branch preview URL."
    - "Forge should run Amplify builds from frontend/ and must not deploy root-level placeholder content."

orchestration:
  mode: coordinator-with-worker-sessions
  worker_session_scope: per-issue
  parallel_implementation: false
  parallel_review: true
  require_isolated_worktree_for_parallel_writes: true

quality:
  self_review_required: true
  independent_review_required: true
  static_checks_required: true
  security_review_required: true
  dependency_review_required: true

linear:
  project: Clock 2
  releases:
    - label: R1
      title: clock-display-foundation
      parent_epic_ids: []
      parent_epic_chain: []
      parent_epic_titles: {}
      issue_ids:
        - ORC-250
        - ORC-252
        - ORC-251
      sequence_document_url: null
  flagged_tickets:
    - id: ORC-259
      title: "Fix the alarm bug"
      reason: "NOT TODO · Backlog"
      action: skipped
    - id: ORC-258
      title: "CLK-009 — Play hourly chime"
      reason: "NOT TODO · Backlog"
      action: skipped
    - id: ORC-257
      title: "CLK-008 — Set alarm at specific time"
      reason: "MISSING RELEASE LABEL"
      action: skipped
    - id: ORC-256
      title: "CLK-007 — Sync preferences across devices (BLOCKED)"
      reason: "NOT TODO · Backlog"
      action: skipped
    - id: ORC-255
      title: "CLK-006 — Persist preferences to localStorage"
      reason: "NOT TODO · Backlog"
      action: skipped
    - id: ORC-254
      title: "CLK-005 — Show timezone label"
      reason: "NOT TODO · Backlog"
      action: skipped
    - id: ORC-253
      title: "CLK-004 — Dark and light theme toggle"
      reason: "NOT TODO · Backlog"
      action: skipped
  statuses:
    backlog: Backlog
    todo: Todo
    blocked: Blocked
    in_progress: In Progress
    in_review: In Review
    build_complete: Build Complete
    pr_open: PR Open
    deployed: Deployed
    deployed_tested: Deployed & Tested
    canceled: Canceled
    duplicate: Duplicate
  blocker_satisfied_statuses:
    per_release:
      - Build Complete
      - PR Open
      - Deployed
      - Deployed & Tested
    per_ticket:
      - PR Open
      - Deployed
      - Deployed & Tested
  selection:
    ready_status: Todo
    working_status: In Progress
    blocked_status: Blocked
    local_complete_status: Build Complete
    release_label_pattern: "R{number}"
    priority_order:
      - Urgent
      - High
      - Medium
      - Low

testing:
  local_required: true
  acceptance_criteria_required: true
  browser_tool: playwright
  deployed_verification_required: true
  commands:
    - cd frontend && pnpm lint
    - cd frontend && pnpm test
  build_commands:
    - cd frontend && pnpm build
  notes:
    - "Run frontend checks from frontend/."

design:
  reference: null
  fidelity: loose-inspiration
